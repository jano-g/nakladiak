# ---------------------------------------------------------------------------
# Nakladiak – všetky pravidelné náklady domácností na jednom mieste.
# Skopíruj na .env a vyplň LEN heslo admina. Všetko ostatné (Claude API, schránka, ZSD,
# SMTP, ntfy, pripomienky) sa nastavuje v aplikácii: Nastavenia. .env je v .gitignore (chmod 600).
# ---------------------------------------------------------------------------

# Verejná URL appky (picus new-site.sh z nej berie doménu). Bez lomky na konci.
APP_URL=https://nak.gordulic.sk

# Port na serveri, na ktorom appka počúva (HTTP, iba localhost). nginx robí HTTPS.
# Pridelený port z PICUS A4 (rovnaký default v docker-compose.yml). APP_BIND nikdy 0.0.0.0.
APP_PORT=8180
APP_BIND=127.0.0.1

# Heslo admina (prihlasovacie meno „jano“). Použije sa LEN pri prvom štarte (prázdna databáza).
# Aspoň 8 znakov. Zabudnuté heslo:  docker compose exec nakladiak python -m app.cli set-password jano
ADMIN_PASSWORD=zmen-ma-aspon-8-znakov
