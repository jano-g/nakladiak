# ---------------------------------------------------------------------------
# Nakladiak – všetky pravidelné náklady domácností na jednom mieste.
# Skopíruj na .env a vyplň. .env je v .gitignore (chmod 600).
# ---------------------------------------------------------------------------

# Verejná URL appky (odkazy v notifikáciách; picus new-site.sh z nej berie doménu). Bez lomky na konci.
APP_URL=https://nak.gordulic.sk

# Port na serveri, na ktorom appka počúva (HTTP, iba localhost). nginx robí HTTPS.
# Pridelený port z PICUS A4 (rovnaký default v docker-compose.yml). APP_BIND nikdy 0.0.0.0 —
# obišlo by to firewall a new-site.sh to odmietne. (Komentáre v .env len na vlastnom riadku.)
APP_PORT=8180
APP_BIND=127.0.0.1

# Časová zóna (dátumy, denné joby).
APP_TZ=Europe/Bratislava

# Admin appky. Použije sa LEN pri prvom štarte (prázdna databáza). Heslo aspoň 8 znakov.
# Zabudnuté heslo:  docker compose exec nakladiak python -m app.cli set-password jano
ADMIN_USERNAME=jano
ADMIN_NAME=Jano
ADMIN_EMAIL=
ADMIN_PASSWORD=zmen-ma-aspon-8-znakov

# Podpisový kľúč pre cookies. Ak necháš prázdne, vygeneruje sa raz do /data/secret.key,
# takže deploy ani reštart nikoho neodhlási (prihlásenie platí 30 dní od poslednej návštevy).
# Ak ho vyplníš, aspoň 32 znakov: openssl rand -hex 32
SECRET_KEY=

# --- Nasledujúce sa dajú vyplniť aj neskôr v appke (Nastavenia) ---------------

# Claude API – čítanie účtov, účteniek a výpisov (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Schránka, do ktorej chodia účty od dodávateľov (IMAP). Appka ju číta každých 15 minút
# a prílohy (PDF, fotky) spracuje sama. websupport: imap.m1.websupport.sk, 993 = SSL.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_ENABLED=1
# Len z týchto adries/domén sa dokumenty z mailu spracujú automaticky (čiarkou oddelené, napr.
# zse.sk, spp.sk, jano@silnereci.sk). Prázdne = všetci odosielatelia (prílohy od neznámych
# odosielateľov aj tak skončia na potvrdenie, ak sa nepriradia podľa identifikátora).
IMAP_ALLOWED_SENDERS=

# ZSD diportal.sk – 15-minútové dáta elektriny (odber aj dodávka) pre všetky odberné miesta
# jedného konta. Prihlásenie chráni reCAPTCHA, rieši ju 2captcha.com (API kľúč).
ZSD_USER=
ZSD_PASSWORD=
ZSD_BUSINESS_PARTNER_ID=
TWOCAPTCHA_API_KEY=
ZSD_ENABLED=1
ZSD_TIME=14:35

# SMTP (websupport.sk: smtp.m1.websupport.sk, 465 = SSL; meno = celá adresa) – voliteľné.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Nakladiak

# Push notifikácie (tému si nastavíš v Profile).
NTFY_SERVER=https://ntfy.sh
# Chyby appky (spadnutý job, chyba 500) — rovnaká téma ako infra alerty niko1
# (hodnota je v /etc/web-healthcheck.env). Prázdne = vypnuté.
ALERT_NTFY_TOPIC=

# Pripomienka „nahraj výpis z účtu“ každých N dní (0 = vypnuté).
STATEMENT_REMINDER_DAYS=30
